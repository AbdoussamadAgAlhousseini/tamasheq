# Ne jamais committer de fichier .env.

# --- API : copier vers services/api/.env ---
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://tamasheq:tamasheq@localhost:5432/tamasheq
# Origines autorisées pour le navigateur (format JSON).
CORS_ORIGINS=["http://localhost:3000"]

# Assistant (désactivé si la clé est absente). Clé à créer sur console.anthropic.com ;
# ne jamais la committer ni la mettre dans une variable NEXT_PUBLIC_*.
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max — plus haut : réponses plus réfléchies, plus coûteuses.
CHAT_EFFORT=medium
CHAT_REQUESTS_PER_MINUTE=10

# --- Frontend : copier vers apps/web/.env.local ---
# Adresse publique de l'API, intégrée au build (variable exposée au navigateur, jamais de secret ici).
NEXT_PUBLIC_API_URL=http://localhost:8000
